{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/a1/run_manifest.schema.json",
  "title": "A1 mandatory run manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "run_id", "provider", "model_name", "model_version_identifier", "interface_runtime", "reasoning_setting", "utc_start_time", "utc_end_time", "exact_user_prompt_template", "exact_case_payload", "exact_system_prompt", "exact_developer_prompt", "temperature", "top_p", "maximum_output_tokens", "tool_access", "browser_access", "memory_access", "retrieval_project_context_access", "context_isolation_method", "case_execution_order", "retry_policy", "timeout_handling", "truncation_handling", "refusal_handling", "model_provider_errors", "collector_software_version", "source_repository_sha256", "case_set_sha256", "raw_response_sha256"],
  "properties": {
    "schema_version": {"const": "A1-RUN-MANIFEST-1.1"},
    "run_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "model_name": {"type": "string", "minLength": 1},
    "model_version_identifier": {"type": "string", "minLength": 1},
    "interface_runtime": {"type": "string", "minLength": 1},
    "reasoning_setting": {"type": "string", "minLength": 1},
    "utc_start_time": {"type": "string", "format": "date-time"},
    "utc_end_time": {"type": "string", "format": "date-time"},
    "exact_user_prompt_template": {"type": "string", "minLength": 1},
    "exact_case_payload": {"type": "array", "minItems": 1},
    "exact_system_prompt": {"type": "string", "minLength": 1},
    "exact_developer_prompt": {"type": "string", "minLength": 1},
    "temperature": {"oneOf": [{"type": "number"}, {"const": "UNAVAILABLE / NOT EXPOSED"}]},
    "top_p": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"const": "UNAVAILABLE / NOT EXPOSED"}]},
    "maximum_output_tokens": {"oneOf": [{"type": "integer", "minimum": 1}, {"const": "UNAVAILABLE / NOT EXPOSED"}]},
    "tool_access": {"type": "string", "minLength": 1},
    "browser_access": {"type": "string", "minLength": 1},
    "memory_access": {"type": "string", "minLength": 1},
    "retrieval_project_context_access": {"type": "string", "minLength": 1},
    "context_isolation_method": {"type": "string", "minLength": 1},
    "case_execution_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "retry_policy": {"type": "string", "minLength": 1},
    "timeout_handling": {"type": "string", "minLength": 1},
    "truncation_handling": {"type": "string", "minLength": 1},
    "refusal_handling": {"type": "string", "minLength": 1},
    "model_provider_errors": {"type": "array"},
    "collector_software_version": {"type": "string", "minLength": 1},
    "source_repository_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "case_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "raw_response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
